# cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is gitignored)
# account_id is read from CLOUDFLARE_ACCOUNT_ID (scripts/with-secrets.sh sets TF_VAR_account_id)
zone_name            = "example.com"
hostname             = "trail.example.com"
allowed_emails       = ["you@example.com"]
attach_custom_domain = false # set true after the first `wrangler deploy`

# Google login: set these as environment variables instead of writing them here:
#   export TF_VAR_google_client_id=...  TF_VAR_google_client_secret=...
