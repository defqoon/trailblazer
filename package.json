{
  "name": "trailblazer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w apps/web && wrangler dev",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "deploy": "npm run build && wrangler d1 migrations apply trailblazer --remote && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply trailblazer --local",
    "typecheck": "tsc -p apps/worker && tsc -p apps/web && tsc -p packages/shared",
    "test": "vitest run",
    "infra:sync": "node scripts/sync-wrangler-from-terraform.mjs",
    "infra:plan": "terraform -chdir=infra/terraform plan",
    "infra:apply": "terraform -chdir=infra/terraform apply",
    "db:check": "drizzle-kit check",
    "db:migrate:remote": "wrangler d1 migrations apply trailblazer --remote",
    "db:status": "wrangler d1 migrations list trailblazer --local",
    "db:status:remote": "wrangler d1 migrations list trailblazer --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "workerd@1.20261118.1": true
  },
  "engines": {
    "node": ">=22"
  }
}
